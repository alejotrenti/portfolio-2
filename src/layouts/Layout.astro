---
interface Props {
	title: string;
	description: string;
	currentLocale: 'es' | 'en';
	headerText: {
		home: string;
		projects: string;
		about: string;
		contact: string;
		profile: string;
    };
	footerText: {
		home: string;
		projects: string;
		about: string;
		contact: string;
		profile: string;
	}
}


const { title, description, currentLocale, headerText, footerText} = Astro.props;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang={currentLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta name="generator" content={Astro.generator} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={`${Astro.url.origin}/og-image.png`} />


		<title>{title}</title>
		<script>
			// On page load or when changing themes, best to add inline in `head` to avoid FOUC
			if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark')
			}
		</script>
	</head>
	<body class="bg-[#F4F4F4] dark:bg-gray-700 min-h-screen flex flex-col">
	<Header headerText={headerText} currentLocale={currentLocale} />

	<div class="flex-1">
		<slot />
	</div>

	<Footer footerText={footerText} currentLocale={currentLocale} />
	</body>
</html>
<style is:global>
  html {
    font-family: 'Josefin Sans', system-ui, sans-serif;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  html::-webkit-scrollbar {
    display: none;
  }

  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
  }

  body::-webkit-scrollbar {
    display: none;
  }
</style>
