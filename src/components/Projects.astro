---
import FutureSkillsEngineImg from '../assets/future.png';
import MLParkinsonImg from '../assets/parkinson.png';
import MercadoLaboralArgImg from '../assets/mercado_dashboard.png';

// Proyectos anteriores (comentados por ahora)
// import FootballNationalAnalysisImg from '../assets/football-national-analysis.jpg';
// import SalesAnalysisImg from '../assets/sales-analysis.png';
// import TPBotaDeOroImg from '../assets/bota-de-oro.png';
---

<section id="projects" class="max-w-6xl mx-auto px-4 py-20">
    <div class="mb-16 text-center">
        <h2 class="text-3xl md:text-5xl  mb-4 dark:text-white">
            Proyectos de <span class="text-cyan-500 dark:text-cyan-400">Data Science</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            Proyectos personales y académicos enfocados en análisis de datos, machine learning e ingeniería de datos.
        </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <article class="group">
            <a href="https://github.com/alejotrenti/future-skills-engine" class="block h-full">
                <div class="relative overflow-hidden rounded-lg mb-4 h-48">
                    <img src={FutureSkillsEngineImg.src} 
                        alt="Dashboard interactivo de predicción de habilidades"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                        <span class="text-white font-medium">Ver detalles →</span>
                    </div>
                </div>
                <div class="px-1">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-xs text-gray-500 dark:text-gray-400">PYTHON · DOCKER · POSTGRESQL· AIRFLOW · STREAMLIT</span>
                    </div>
                    <h3 class="text-xl font-bold dark:text-white mb-2">Future Skills Engine</h3>
                    <p class="text-gray-600 dark:text-gray-300 text-sm">Plataforma de datos para analizar tendencias tecnológicas e identificar habilidades emergentes a partir de múltiples fuentes.</p>
                </div>
            </a>
        </article>

        <article class="group">
            <a href="https://www.linkedin.com/feed/update/urn:li:activity:7473849247327645697/" class="block h-full">
                <div class="relative overflow-hidden rounded-lg mb-4 h-48">
                    <img src={MLParkinsonImg.src} 
                        alt="Análisis de datos para detección de Parkinson"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                        <span class="text-white font-medium">Ver detalles →</span>
                    </div>
                </div>
                <div class="px-1">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-xs text-gray-500 dark:text-gray-400">PYTHON · SCIKIT-LEARN · PANDAS</span>
                    </div>
                    <h3 class="text-xl font-bold dark:text-white mb-2">Predicción de Parkinson con Machine Learning</h3>
                    <p class="text-gray-600 dark:text-gray-300 text-sm">Modelo de clasificación basado en datos biomédicos para predecir la presencia de la enfermedad de Parkinson.</p>
                </div>
            </a>
        </article>

        <article class="group">
            <a href="https://github.com/alejotrenti/mercado-laboral-argentina" class="block h-full" >
                <div class="relative overflow-hidden rounded-lg mb-4 h-48">
                    <img src={MercadoLaboralArgImg.src} 
                        alt="Dashboard del mercado laboral argentino"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                        <span class="text-white font-medium">Ver detalles →</span>
                    </div>
                </div>
                <div class="px-1">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-xs text-gray-500 dark:text-gray-400">PYTHON · PANDAS · SCIKIT-LEARN · POWER-BI</span>
                    </div>
                    <h3 class="text-xl font-bold dark:text-white mb-2">Mercado Laboral Argentino</h3>
                    <p class="text-gray-600 dark:text-gray-300 text-sm">Dashboard interactivo con indicadores clave del mercado laboral argentino utilizando datos del INDEC</p>
                </div>
            </a>
        </article>
    </div>

    <div class="mt-20 text-center">
        <a href="/projects" class="inline-flex items-center px-6 py-3 border border-cyan-500 text-cyan-500 dark:text-cyan-400 rounded-full hover:bg-cyan-500 hover:text-white transition-colors">
            Ver todos mis proyectos
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
        </a>
    </div>
</section>